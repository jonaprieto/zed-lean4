[
  {
    "label": "Lean: terminal infoview",
    "command": "$HOME/.cache/lean4-ide/bin/lean4-ide-proxy",
    "args": ["tui"],
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "no_focus",
    "hide": "on_success",
    "show_summary": false,
    "show_command": false,
    "tags": ["lean-infoview"]
  },
  {
    "label": "Lean: lake build",
    "command": "lake",
    "args": ["build"],
    "allow_concurrent_runs": false,
    "reveal": "no_focus"
  },
  {
    "label": "Lean: lake update",
    "command": "lake",
    "args": ["update"],
    "allow_concurrent_runs": false,
    "reveal": "no_focus"
  },
  {
    "label": "Lean: lake clean",
    "command": "lake",
    "args": ["clean"],
    "allow_concurrent_runs": false,
    "reveal": "no_focus"
  },
  {
    "label": "Lean: fetch the Mathlib cache",
    "command": "lake",
    "args": ["exe", "cache", "get"],
    "allow_concurrent_runs": false,
    "reveal": "no_focus"
  }
]
